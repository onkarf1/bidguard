# Filled in automatically by `yarn setup:devnet` in the repo root.
NEXT_PUBLIC_CLUSTER=devnet
NEXT_PUBLIC_RPC_URL=https://api.devnet.solana.com
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_USDC_MINT=

# Server-only. The arbiter key signs AI rulings and mints test USDC from the faucet.
ARBITER_SECRET_KEY=

# AI arbitrator, option 1: any OpenAI-compatible API (Qwen, DeepSeek, Llama hosts, ...)
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=
LLM_ENABLE_THINKING=false

# AI arbitrator, option 2: Claude (used when LLM_BASE_URL is empty)
# ANTHROPIC_API_KEY=
