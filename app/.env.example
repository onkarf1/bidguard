# Solana settings: written automatically by `yarn setup` in the repo root.
NEXT_PUBLIC_CLUSTER=devnet
NEXT_PUBLIC_RPC_URL=https://api.devnet.solana.com
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_USDC_MINT=

# Server-only keys (base58). Operator: approves vetted auctions, settles winning bids, reports
# carrier delivery, mints test USDC. Arbiter: executes dispute outcomes; receives fees.
OPERATOR_SECRET_KEY=
ARBITER_SECRET_KEY=

# MongoDB Atlas connection string (live auction state, listings, images, agent runs)
MONGODB_URI=

# AI agents: Gemini through its OpenAI-compatible endpoint
GEMINI_API_KEY=
AI_MODEL=gemini-3-flash-preview
# Optional: any other OpenAI-compatible provider
# AI_BASE_URL=
# AI_API_KEY=

# Moderator page (/admin): a long random string, e.g. `openssl rand -hex 24`
ADMIN_TOKEN=
